{
    "name": "germany-judaica-scraper",
    "version": "1.0.0",
    "description": "Finds Judaica retailers in Germany, England, France, Belgium, the United States or Israel on Google Maps, pulls email, owner name and WhatsApp from each shop's website, and writes a prioritised outreach sheet for Jaffa Glass; sushi restaurants in Israel and across Europe; and galleries, auction houses, art dealers and art advisors in the US, Israel and 76 more countries for Varnish AI.",
    "type": "module",
    "engines": {
        "node": ">=18"
    },
    "scripts": {
        "start": "node src/main.js",
        "smoke": "node src/main.js --input ./input.smoke.json",
        "england": "node src/main.js --input ./input.england.json",
        "smoke:england": "node src/main.js --input ./input.england-smoke.json",
        "france": "node src/main.js --input ./input.france.json",
        "smoke:france": "node src/main.js --input ./input.france-smoke.json",
        "belgium": "node src/main.js --input ./input.belgium.json",
        "smoke:belgium": "node src/main.js --input ./input.belgium-smoke.json",
        "us": "node src/main.js --input ./input.us.json",
        "smoke:us": "node src/main.js --input ./input.us-smoke.json",
        "israel": "node src/main.js --input ./input.israel.json",
        "smoke:israel": "node src/main.js --input ./input.israel-smoke.json",
        "sushi:israel": "node src/main.js --input ./input.israel-sushi.json",
        "smoke:sushi:israel": "node src/main.js --input ./input.israel-sushi-smoke.json",
        "sushi:europe": "node src/main.js --input ./input.europe-sushi.json",
        "smoke:sushi:europe": "node src/main.js --input ./input.europe-sushi-smoke.json",
        "sushi:germany": "node src/main.js --input ./input.germany-sushi.json",
        "art:us": "node src/main.js --input ./input.us-art.json",
        "smoke:art:us": "node src/main.js --input ./input.us-art-smoke.json",
        "art:il": "node src/main.js --input ./input.il-art.json",
        "smoke:art:il": "node src/main.js --input ./input.il-art-smoke.json",
        "art:world": "node src/main.js --input ./input.world-art.json",
        "smoke:art:world": "node src/main.js --input ./input.world-art-smoke.json",
        "smoke:art:hu": "node src/main.js --input ./input.world-art-hu-smoke.json",
        "contacts": "node src/contacts-cli.js",
        "test": "node --test test/*.test.js"
    },
    "dependencies": {
        "puppeteer-core": "^22.0.0",
        "exceljs": "^4.4.0"
    },
    "devDependencies": {
        "jsdom": "^24.1.0"
    }
}
