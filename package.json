{
    "name": "germany-judaica-scraper",
    "version": "1.0.0",
    "description": "Finds Judaica retailers in Germany, England, France or Belgium on Google Maps, pulls email, owner name and WhatsApp from each shop's website, and writes a prioritised outreach sheet for Jaffa Glass.",
    "type": "module",
    "engines": {
        "node": ">=18"
    },
    "scripts": {
        "start": "node src/main.js",
        "smoke": "node src/main.js --input ./input.smoke.json",
        "england": "node src/main.js --input ./input.england.json",
        "smoke:england": "node src/main.js --input ./input.england-smoke.json",
        "france": "node src/main.js --input ./input.france.json",
        "smoke:france": "node src/main.js --input ./input.france-smoke.json",
        "belgium": "node src/main.js --input ./input.belgium.json",
        "smoke:belgium": "node src/main.js --input ./input.belgium-smoke.json",
        "contacts": "node src/contacts-cli.js",
        "test": "node --test test/*.test.js"
    },
    "dependencies": {
        "puppeteer-core": "^22.0.0",
        "exceljs": "^4.4.0"
    },
    "devDependencies": {
        "jsdom": "^24.1.0"
    }
}
